# Provider selection — swap any to 'mock' for free local testing
TELEPHONY_PROVIDER=mock        # mock | telnyx | twilio
STT_PROVIDER=mock              # mock | deepgram
TTS_PROVIDER=mock              # mock | cartesia | elevenlabs
LLM_PROVIDER=mock              # mock | claude | gemini-flash | llama
DIRECTORY_PROVIDER=mock        # mock | google_places

# Anthropic (used for post-call extraction even in mock mode)
ANTHROPIC_API_KEY=

# Telnyx (telephony)
TELNYX_API_KEY=
TELNYX_APP_PORT=8080
TELNYX_PUBLIC_URL=             # ngrok URL for webhooks

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Cartesia (TTS)
CARTESIA_API_KEY=

# Google Places (contractor directory)
GOOGLE_PLACES_API_KEY=

# Concurrency
MAX_CONCURRENT_CALLS=10
CALL_TIMEOUT_SECONDS=180
